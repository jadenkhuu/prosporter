# Copy to .env.local and fill in. Never commit .env.local.

# --- WooCommerce / WordPress (read-only migration source; scripts/audit, migration pipeline)
WOO_BASE_URL=https://prosporter.com.au
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WP_MIGRATION_USER=
WP_APPLICATION_PASSWORD=

# --- Site URL (canonical origin; read by src/lib/site.ts only)
# The one value every canonical, Open Graph URL, robots.txt Sitemap line and sitemap.xml
# entry is built from. Set it in Vercel Production to the live origin. Leave it unset on
# Preview: the deployment then falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# and robots.txt is disallow-all there anyway (VERCEL_ENV != production).
NEXT_PUBLIC_SITE_URL=

# --- Shopify Storefront API (Next.js storefront; read by src/lib/shopify/config.ts only)
# *.myshopify.com domain of the client-owned store
SHOPIFY_STORE_DOMAIN=
# Public Storefront access token from the Headless channel (separate tokens per environment)
SHOPIFY_STOREFRONT_TOKEN=
# Optional: quarterly API version, defaults to 2026-07
SHOPIFY_STOREFRONT_API_VERSION=
# Optional: per-request timeout in ms, defaults to 10000
SHOPIFY_STOREFRONT_TIMEOUT_MS=
# Set to 1 to let a production server boot without Shopify configured (prototype/mock mode only)
SHOPIFY_OPTIONAL=

# --- Shopify Admin API (migration pipeline only; never loaded by the storefront)
# Dev Dashboard app "ProSporter-migration" -> Settings -> Client credentials.
# scripts/migration/shopify_admin.py mints 24h tokens from these (client credentials grant)
# and caches them under exports/migration/.admin-token.json (git-ignored, mode 600).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Optional override: a pre-minted shpat_ token (testing only; expires after 24h)
SHOPIFY_ADMIN_TOKEN=

# --- Shopify webhooks (src/app/api/webhooks/shopify; see docs/webhooks.md)
# HMAC signing key = the ProSporter-migration app's client secret (same value as SHOPIFY_ADMIN_CLIENT_SECRET)
SHOPIFY_WEBHOOK_SECRET=
# Optional comma-separated allow-list of X-Shopify-Shop-Domain values (defaults to the store's domains)
SHOPIFY_WEBHOOK_ALLOWED_SHOPS=

# --- Logging: debug | info | warn | error (defaults: debug in development, info in production)
LOG_LEVEL=
