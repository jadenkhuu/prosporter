{
  "name": "prosporter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/lib/shopify/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "npm run lint && npm run typecheck && SHOPIFY_OPTIONAL=1 npm run build && npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
